PORT=4000
NODE_ENV=development
# Required persistent MongoDB replica set (e.g. Atlas). Never commit the actual URI.
MONGODB_URI=
MONGODB_DB=civicclean
JWT_SECRET=
JWT_EXPIRES_IN=24h
UPLOAD_TOKEN_SECRET=
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:4000
# Production requires cloudinary. Local is for local development only.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civicclean
# Optional: gemini or anthropic. Choose an available model in your provider account.
VISION_PROVIDER=none
VISION_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=10000
ALLOW_ROUTING_ESTIMATES=false
DEMO_MODE=false
ALLOW_DEMO_RESET=false
ALLOW_MEMORY_DB=false
# Rectangular pilot acceptance area; not an official ward boundary.
SERVICE_AREA_BBOX=[72.75,18.85,73.05,19.35]
DUP_RADIUS_M=100
DUP_WINDOW_DAYS=7
